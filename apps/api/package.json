{
  "name": "@nexbridge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "pretest": "DATABASE_URL=postgresql://nexbridge@127.0.0.1:5433/nexbridge_test node ./node_modules/prisma/build/index.js migrate deploy",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "db:generate": "node --env-file=../../.env ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "tsx --env-file=../../.env src/seed/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@nexbridge/shared": "workspace:*",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.7.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.0",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
