# ============================================================
# NEXBRIDGE — variables d'environnement
# Copiez ce fichier en `.env` (jamais commité) et adaptez les valeurs.
# Aucun secret réel ne doit figurer dans ce fichier d'exemple.
# ============================================================

# --- Général -------------------------------------------------
NODE_ENV=development              # development | staging | production
APP_URL=http://localhost:5173     # URL publique du front (liens dans les e-mails, CORS)
API_PORT=4000
# Affiche un bandeau « Données de démonstration » et autorise le seed (refusé si NODE_ENV=production)
DEMO_MODE=true

# --- Base de données / Redis --------------------------------
DATABASE_URL=postgresql://nexbridge@127.0.0.1:5433/nexbridge
REDIS_URL=redis://127.0.0.1:6380

# --- Sécurité -----------------------------------------------
# JWT RS256 : en production, fournissez les clés (PEM, retours à la ligne en \n).
# En développement, une paire est générée automatiquement dans .nexbridge-local/keys/.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Clé AES-256 (32 octets en base64) pour chiffrer NINEA/RCCM, secrets 2FA… ; générée en dev si absente.
# Production : `openssl rand -base64 32`, stockée dans un gestionnaire de secrets.
ENCRYPTION_KEY=
COOKIE_SECURE=false               # true en HTTPS (obligatoire hors développement)

# --- Fichiers -----------------------------------------------
STORAGE_DRIVER=local              # local | s3
STORAGE_LOCAL_DIR=.nexbridge-local/uploads
# S3 (si STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                    # optionnel : R2, MinIO…
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Intégrations (laisser vide = « non configuré », rien ne casse) ---
SENDGRID_API_KEY=
MAIL_FROM="NEXBRIDGE <no-reply@nexbridge.example>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Paiement par carte (Stripe). Laisser vide = seul le virement manuel est proposé.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CLAMAV_HOST=
CLAMAV_PORT=3310
